# /etc/default/k2-detect
# 1 = pause the K2 on a sustained Obico score, 0 = alerts only (start here)
K2_AUTOPAUSE=0
K2_MR=http://127.0.0.1:7126
K2_CAM=http://127.0.0.1:8080/snapshot
K2_VLM=http://127.0.0.1:8090
# Optional: deliver alerts over ssh (see README); unset = log only
#K2_ALERT_SSH=alerts@your-server
#K2_ALERT_KNOWN_HOSTS=/etc/k2-detect/known_hosts

# printer-overrides.cfg: YOUR settings for this printer.
#
# k2-openklipper.cfg (next to this file) is the managed open-stack config: it
# is replaced from the installed build on every start and every update, so
# never edit it. This file is loaded after it, so anything here wins, and
# updates never touch it.
#
# To change a setting, repeat its section header here with only the options
# you want to change. For example, the first-layer height, like Creality's
# Z offset and Mainsail's live Z offset buttons (negative = nozzle closer to
# the bed, positive = further away):
#
#   [gcode_macro START_PRINT]
#   variable_z_offset: -0.02
#
# or a different input shaper result:
#
#   [input_shaper]
#   shaper_freq_x: 52.0
#
# Bed mesh limits checked at the start of a print (mm, and mm per mm between
# points). An unshimmed K2 Plus bed can need more than the defaults (0.35 and
# 0.006): one tester's 0.675 mm bed printed well with these:
#
#   [gcode_macro START_PRINT]
#   variable_mesh_max_deviation: 0.85
#   variable_mesh_max_slope: 0.009
#
# A denser bed mesh: with a probe_count above about 13, 13 use mesh_pps 1, 1.
# The default 2, 2 adds little at that spacing and costs a lot of work on the
# printer's own board: one K2 Plus shut down with "Stepper too far in past" as
# a full-bed 19x19 or 21x21 mesh finished at the start of a print, and printed
# fine at 21x21 with this:
#
#   [bed_mesh]
#   probe_count: 21, 21
#   mesh_pps: 1, 1
#
# Extra seconds of motion kept queued, for stalls of the printer's own board
# (default 0.5, benefit not proven yet). Pause and cancel respond that much
# later:
#
#   [printer]
#   buffer_headroom: 1.0
#
# Idle settings. Chamber light off this many seconds after a print ends or
# is cancelled (0 = stays on):
#
#   [gcode_macro _LIGHT_IDLE]
#   variable_off_after: 600
#
# Heaters and motors off (the bed is released and the next print homes in
# full) after this long idle, in seconds (default 1800):
#
#   [idle_timeout]
#   timeout: 3600
#
# Always home in full at print start, even when still homed from the last
# print:
#
#   [gcode_macro START_PRINT]
#   variable_warm_start: False

# Extruder, set by the installer (stock Creality extruder or Phaetus DXC2):
# cut depth and the pull-back after each cut. See docs/INSTALL.md.
[k2_cfs]
cutter_cut_x: __CUT_X__
unload_pull_length: __PULL__
# CFS (Creality Filament System). auto: found at each start; without one the
# printer uses the rear spool holder (LOAD_FILAMENT / UNLOAD_FILAMENT), and a
# CFS connected later is picked up while idle. True: always expect a CFS.
# False: never use one.
cfs_fitted: __CFS_FITTED__

# Your CFS's id from Creality's config, if it had one. Optional: the driver
# finds the CFS by itself at startup.
[k2_motor_bus]
cfs_uniid: __CFS_UNIID__

# Creality Hi USB host-link (3 gadget serial ports) -> /dev/ttyUSB* through
# usbserial generic. Install: sudo cp to /etc/udev/rules.d/ then
# sudo udevadm control --reload && sudo udevadm trigger
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0525", ATTR{idProduct}=="a4a6", RUN+="/sbin/modprobe usbserial", RUN+="/bin/sh -c 'echo 0525 a4a6 > /sys/bus/usb-serial/drivers/generic/new_id'"

# Hark Screen - the K2 touchscreen. Default look: Klipper's logo and colours.
# Edit and save: the screen picks up changes within a second, no restart.
# How to make it your own: docs/SCREEN-CUSTOMISE.md. Another example theme:
# harkscreen/themes/hark-tech.cfg

[brand]
# Shown in the header
name: K2 OpenKlipper
# PNG in this folder (or a full path). Transparent PNGs work best.
logo: klipper-logo.png
# Show the logo large on the Status page when nothing is printing
idle_logo: yes

[theme]
# Colours as #RRGGBB (Klipper slate and red)
background: #12171d
panel: #1b232c
panel_edge: #3c4b5a
accent: #d9434a
text: #eef2f6
muted: #8a97a6
ok: #2ecc71
warn: #f5a623
error: #ff6b6b
# Any TTF/OTF font file, and a size multiplier
font: /etc/sysConfig/defData/SourceHanSansCN-Normal.otf
font_scale: 1.0

[screen]
# Pages in the side bar, in order: status, cfs, controls, machine, wifi
pages: status,cfs,controls,machine,wifi
# Seconds between redraws
refresh: 1.0
# Turn the panel off after this many idle seconds (0 = never).
# Never sleeps while printing; a tap wakes it.
sleep_after: 600
# Timezone for the "done about" time: uk (GMT/BST) or hours from UTC, e.g. +2
timezone: uk
moonraker: http://127.0.0.1:7126
# Panel rotation in degrees clockwise (K2: 90 = landscape, 0 = portrait)
rotate: 90
# Touch calibration, only if taps land in the wrong place
touch_max_x: 480
touch_max_y: 800
touch_swap_xy: no
touch_invert_x: no
touch_invert_y: no
